# --- Провайдер LLM по умолчанию ----------------------------------------------
# Ключ живёт ТОЛЬКО на шлюзе: не в браузере, не в приложениях (раздел 8 ТЗ).
# Засеивает реестр data/providers.json при первом запуске; дальнейшее
# управление провайдерами (включая локальные vLLM/Ollama и Anthropic) —
# через GET/PUT /admin/api/providers (Э3).
AIGATE_PROVIDER_NAME=openai
AIGATE_PROVIDER_BASE_URL=https://api.openai.com/v1
AIGATE_PROVIDER_API_KEY=
AIGATE_PROVIDER_MODEL=gpt-4o-mini
AIGATE_PROVIDERS_PATH=data/providers.json

# --- Семантический детект контекстных утечек (Э3): off | flag | block ---------
# LLM-judge поверх обезличенного текста; рекомендуется локальный провайдер.
AIGATE_SEMANTIC_GUARD=off
AIGATE_SEMANTIC_GUARD_PROVIDER=

# --- Аутентификация ----------------------------------------------------------
# Ключи каналов (расширение, приложения) через запятую. Пусто = dev-режим.
AIGATE_CHANNEL_API_KEYS=
# Токен Control Plane. Пусто = админка доступна только с localhost.
AIGATE_ADMIN_TOKEN=

# --- Mapping Store (ст. 12: локально, эфемерно) --------------------------------
AIGATE_MAPPING_TTL_SECONDS=600
# Fernet-ключ шифрования значений в памяти; пусто = генерируется на старте.
AIGATE_MAPPING_ENCRYPTION_KEY=

# --- Пути (внутри периметра) ----------------------------------------------------
AIGATE_AUDIT_LOG_PATH=data/audit.log
AIGATE_POLICY_PATH=data/policy.json
AIGATE_DETECTOR_RULES_PATH=data/detector_rules.json

# --- Fail-closed (выключать только на стенде) -----------------------------------
AIGATE_FAIL_CLOSED=true
