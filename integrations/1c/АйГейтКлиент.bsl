// Общий модуль «АйГейтКлиент» — коннектор 1С к шлюзу AI-Gate (Э2).
//
// Экспериментальный пример: проверьте на своей конфигурации (8.3.10+).
// Все обращения 1С к LLM направляются через шлюз: детект, маскирование,
// политика и аудит — центральные. Ключ LLM-провайдера в 1С не хранится.
//
// Настройки берутся из констант (создайте в конфигурации):
//   АйГейтАдресШлюза  — например, "http://aigate.internal:8080"
//   АйГейтКлючКанала  — ключ канала (X-AIGate-Key)

// Проверить/замаскировать текст перед любым использованием во внешней LLM.
// Возвращает Структуру: Вердикт, МаскированныйТекст, Сессия, Сообщение.
Функция ПроверитьТекст(Знач Текст, Знач Пользователь = "1c-user") Экспорт

	Тело = Новый Структура;
	Тело.Вставить("text", Текст);
	Тело.Вставить("user", Пользователь);
	Тело.Вставить("channel", "egress");
	Тело.Вставить("dry_run", Истина);

	Ответ = ВызватьШлюз("/v1/check", Тело);

	Результат = Новый Структура;
	Результат.Вставить("Вердикт", Ответ["verdict"]);
	Результат.Вставить("МаскированныйТекст", Ответ["masked_text"]);
	Результат.Вставить("Сессия", Ответ["session_id"]);
	Результат.Вставить("Сообщение", Ответ["message"]);
	Возврат Результат;

КонецФункции

// Полный цикл: маскирование -> LLM -> ответ с восстановленными значениями.
Функция СпроситьLLM(Знач Текст, Знач Пользователь = "1c-user") Экспорт

	Тело = Новый Структура;
	Тело.Вставить("text", Текст);
	Тело.Вставить("user", Пользователь);
	Тело.Вставить("channel", "egress");

	Ответ = ВызватьШлюз("/v1/check", Тело);

	Если Ответ["verdict"] = "blocked" Или Ответ["verdict"] = "fail_closed" Тогда
		ВызватьИсключение "AI-Gate: " + Строка(Ответ["message"]);
	КонецЕсли;

	Возврат Ответ["answer"];

КонецФункции

// --- служебное ---------------------------------------------------------------

Функция ВызватьШлюз(Знач Путь, Знач ТелоСтруктура)

	АдресШлюза = Константы.АйГейтАдресШлюза.Получить();
	КлючКанала = Константы.АйГейтКлючКанала.Получить();

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТелоСтруктура);
	ТелоСтрока = ЗаписьJSON.Закрыть();

	СтруктураURI = РазобратьАдрес(АдресШлюза);
	Соединение = Новый HTTPСоединение(
		СтруктураURI.Хост, СтруктураURI.Порт, , , ,
		30); // таймаут, сек

	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Если ЗначениеЗаполнено(КлючКанала) Тогда
		Запрос.Заголовки.Вставить("X-AIGate-Key", КлючКанала);
	КонецЕсли;
	Запрос.УстановитьТелоИзСтроки(ТелоСтрока, КодировкаТекста.UTF8);

	Результат = Соединение.ОтправитьДляОбработки(Запрос);

	// Fail-closed: любая ошибка соединения/статуса — исключение, не пропуск
	Если Результат.КодСостояния <> 200 Тогда
		ВызватьИсключение "AI-Gate: шлюз вернул " + Строка(Результат.КодСостояния)
			+ ": " + Результат.ПолучитьТелоКакСтроку();
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
	Возврат ПрочитатьJSON(ЧтениеJSON, Истина);

КонецФункции

Функция РазобратьАдрес(Знач Адрес)

	Адрес = СтрЗаменить(СтрЗаменить(Адрес, "http://", ""), "https://", "");
	Части = СтрРазделить(Адрес, ":");
	Результат = Новый Структура("Хост, Порт", Части[0], 8080);
	Если Части.Количество() > 1 Тогда
		Результат.Порт = Число(Части[1]);
	КонецЕсли;
	Возврат Результат;

КонецФункции
